# Local Draftspec self-hosting output
/.speckeep/
# /AGENTS.md
/TESTS/

# Binaries
/draftspec
bin/
# The npm launcher lives under a `bin/` dir; keep it tracked or the published
# tarball loses `bin/speckeep.js` and `npm install -g speckeep` creates no shim.
!contrib/packaging/npm/bin/
!contrib/packaging/npm/bin/**

# Build outputs
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Coverage
coverage.out
*.coverprofile

# Go workspace
go.work
go.work.sum

# Editor and OS files
.DS_Store
.idea/
.vscode/
TESTS/*
.claude

# Demo recording workspace
demo/_work/

# Docs site (VitePress)
docs/node_modules/
docs/.vitepress/cache/
docs/.vitepress/dist/
docs/.vitepress/.temp/

# Local scratch / notes
.scratch/
